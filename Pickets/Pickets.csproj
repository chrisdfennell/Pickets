<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Shown in About. CI overrides this with the release tag (-p:Version=...). -->
    <Version>1.17.1</Version>
    <!-- Keep About showing "1.1.1", not "1.1.1+<commit hash>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- App/EXE icon -->
    <ApplicationIcon>Assets\open-fence.ico</ApplicationIcon>

    <!-- Per-monitor DPI awareness -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 suggests WinForms' own DPI setting; this is a WPF app, which needs the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Prevent default wildcard from including the ico as <None> -->
  <ItemGroup>
    <None Remove="Assets\open-fence.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- For WPF pack URI in About dialog -->
    <Resource Include="Assets\open-fence.ico" />

    <!-- For tray icon: ensure file exists at runtime -->
    <Content Include="Assets\open-fence.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Docs\" />
  </ItemGroup>

</Project>
